{
  "$schema": "https://raw.githubusercontent.com/sevten/pi-data-masking/main/masking.config.schema.json",
  "version": 1,
  "enabled": true,
  "rules": [
    {
      "id": "internal-database-host",
      "name": "Internal database host",
      "enabled": false,
      "description": "Exact literal with a stable, realistic-looking replacement",
      "real": "db.prod.internal.example",
      "placeholder": "db-primary.prod.corpnet.internal"
    },
    {
      "id": "production-api-key",
      "name": "Production API key",
      "enabled": true,
      "description": "Production API key read without storing its value in this file",
      "realFromEnv": "PROD_API_KEY",
      "preserveStructure": { "keepPrefix": true }
    },
    {
      "id": "application-token",
      "name": "Application token",
      "enabled": false,
      "description": "Custom regex matching secret_ followed by 24 ASCII letters or digits",
      "type": "regex",
      "pattern": "\\bsecret_[A-Za-z0-9]{24}\\b"
    },
    {
      "id": "github-personal-access-token",
      "name": "GitHub personal access token",
      "preset": "github-pat",
      "enabled": true
    }
  ],
  "options": {
    "caseSensitive": true,
    "showStatusBar": true,
    "systemPromptGuidance": false,
    "persistHistory": true
  }
}
