{
  "name": "@sevten/pi-data-masking",
  "version": "0.6.1",
  "description": "Pi extension that masks sensitive data before it reaches the LLM and restores it for users and tools.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sevten/pi-data-masking"
  },
  "license": "MIT",
  "type": "module",
  "main": "./index.ts",
  "files": [
    "*.ts",
    "common-semantic-terms.txt",
    "masking.config.example.json",
    "masking.config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "data-masking",
    "secret-masking",
    "sensitive-data",
    "llm",
    "llm-security",
    "prompt-security",
    "privacy",
    "api-keys",
    "ai-agent",
    "developer-tools"
  ],
  "scripts": {
    "check": "tsc",
    "pack:dry": "npm pack --dry-run",
    "test": "node --test \"tests/*.test.ts\""
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@types/node": "^26.0.1",
    "ajv": "^8.20.0",
    "typescript": "^6.0.3"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
